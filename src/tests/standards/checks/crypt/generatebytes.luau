--!nocheck
--!nolint

return {
	global = "crypt.generatebytes",
	aliases = {
		"base64_decode",
		"crypt.base64.decode",
		"base64.decode",
		"crypt.base64_decode",
	},
	cases = {
		{
			id = "type",
			run = function(self)
				local referenceCrypt = require("@dependencies/crypt/crypt.luau")
				local size = math.random(1, 512)
				local bytes = crypt.generatebytes(size)
				local decodedBytes = referenceCrypt.base64decode(bytes)
				self._size = size
				if type(decodedBytes) == "string" then
					self._decoded = decodedBytes
				end

				if type(decodedBytes) ~= "string" then
					return {
						status = 500,
						message = "Generated bytes do not form a string",
					}
				end

				return {
					status = 200,
					message = "Passed",
				}
			end,
		},
		{
			id = "length",
			run = function(self)
				if type(self._decoded) ~= "string" or self._size == nil then
					return { status = 200, message = "Passed" }
				end

				local decodedBytes = self._decoded
				local size = self._size
				if #decodedBytes ~= size then
					return {
						status = 500,
						message = "Bytes length mismatch: " .. tostring(#decodedBytes) .. " != " .. tostring(size),
					}
				end

				return {
					status = 200,
					message = "Passed",
				}
			end,
		},
	},
}
